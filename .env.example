# Copy to .env.local. Defaults work for local development.

# Local SQLite file, or a Turso URL (libsql://...) in production.
DATABASE_URL=file:local.db
# Only needed for Turso.
DATABASE_AUTH_TOKEN=

# Signs the session cookie. Use a random 32+ character string.
SESSION_SECRET=change-me-to-a-long-random-string-0123456789
